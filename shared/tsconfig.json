{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./*"]
    }
  },
  "include": [
    "components/ui/**/*",
    "components/common/**/*",
    "components/layout/branding.tsx",
    "components/motion/**/*",
    "constants/**/*",
    "hooks/use-click-outside.ts",
    "hooks/use-keyboard.ts",
    "hooks/use-storage.ts",
    "hooks/types.tsx",
    "lib/query-client.ts",
    "providers/**/*",
    "styles/**/*",
    "types/**/*",
    "utils/**/*"
  ],
  "exclude": [
    "node_modules",
    "components/layout/app-shell.tsx",
    "components/layout/app-shell-client.tsx",
    "components/layout/main-workspace.tsx",
    "components/layout/sidebar-nav.tsx",
    "components/layout/topbar-shell.tsx",
    "components/layout/workspace-shell.tsx",
    "components/common/command-palette.tsx",
    "hooks/use-ai-engine.ts",
    "hooks/use-module-renderers.ts",
    "hooks/use-storage.ts",
    "lib/navigation-store.ts",
    "lib/provider-store.ts",
    "lib/ui-store.ts",
    "services/**/*",
    "services/storage/index.ts",
    "services/platform/**/*",
    "services/providers/**/*",
    "services/crypto/**/*",
    "services/export-import/**/*"
  ]
}