# AI Context Studio Web - Environment Variables
# Copy this file to .env and fill in values

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/ai_context_studio?schema=public"

# ============================================
# AUTHENTICATION (Better Auth)
# ============================================
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Context Studio"
NEXT_PUBLIC_APP_DOMAIN="localhost"

# ============================================
# EMAIL (Resend)
# ============================================
RESEND_API_KEY="re_..."

# ============================================
# OAUTH PROVIDERS
# ============================================
GITHUB_CLIENT_ID="..."
GITHUB_CLIENT_SECRET="..."

GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# ============================================
# PAYMENTS (Stripe)
# ============================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================
# FILE UPLOADS (UploadThing)
# ============================================
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# ============================================
# ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# ============================================
# SOCIAL LINKS
# ============================================
NEXT_PUBLIC_GITHUB_URL="https://github.com/ai-context-studio"
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/ai-context-studio"
NEXT_PUBLIC_TWITTER_URL="https://twitter.com/aicontextstudio"

# ============================================
# BUILD-TIME (for sitemap/robots generation)
# ============================================
SITE_URL="https://ai-context-studio.dev"