# AI Context Studio Web - Environment Variables
# Copy this file to .env.local and fill in values

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://ai-context-studio.vercel.app
NEXT_PUBLIC_SITE_NAME="AI Context Studio"

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Social Links
NEXT_PUBLIC_GITHUB_URL=https://github.com/ai-context-studio
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/ai-context-studio
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/aicontextstudio

# Build-time only (for sitemap/robots generation)
# These are used during `next build` for static generation
SITE_URL=https://ai-context-studio.vercel.app