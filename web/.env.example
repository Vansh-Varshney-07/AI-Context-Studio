# ============================================
# AI Context Studio — Environment Variables
# ============================================

# ---- App ----
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_DOMAIN=.your-domain.com

# ---- Database (Neon Postgres) ----
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/db?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host.region.aws.neon.tech/db?channel_binding=require&sslmode=require

# ---- Auth (better-auth) ----
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# ---- GitHub OAuth (optional) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-domain.com

# ---- GitHub API (unauthenticated rate limit: 60 req/hr) ----
# GITHUB_TOKEN=

# ---- Stripe (optional, for marketplace monetization) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
