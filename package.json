{
  "name": "ai-context-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "web"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "build:web": "npm run build --workspace=web",
    "lint:web": "npm run lint --workspace=web",
    "typecheck:web": "npm run typecheck --workspace=web",
    "db:generate": "npm run db:generate --workspace=web",
    "db:push": "npm run db:push --workspace=web",
    "db:migrate": "npm run db:migrate --workspace=web",
    "db:seed": "npm run db:seed --workspace=web"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
