{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "devCommand": "next dev",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    { "source": "/github", "destination": "https://github.com/Vansh-Varshney-07/AI-Context-Studio", "permanent": true },
    { "source": "/discussions", "destination": "https://github.com/Vansh-Varshney-07/AI-Context-Studio/discussions", "permanent": true },
    { "source": "/issues", "destination": "https://github.com/Vansh-Varshney-07/AI-Context-Studio/issues", "permanent": true }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
